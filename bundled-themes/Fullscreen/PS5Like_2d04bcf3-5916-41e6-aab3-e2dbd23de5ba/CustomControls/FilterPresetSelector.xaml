<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ItemFilterQuickPreset" TargetType="CheckBoxEx">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBoxEx">
                    
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <TextBlock FontFamily="{DynamicResource Comfortaa}"
                                   FontSize="20" VerticalAlignment="Center"
                                   x:Name="TextContent" Margin="5,0">
                                
                            
                                  
                            <Border x:Name="SelectionBorder" BorderBrush="LightGray" Height="40" BorderThickness="2" CornerRadius="20" Padding="0">
                            <Grid>
                                <Image x:Name="FilterIcon" RenderOptions.BitmapScalingMode="Fant"
						 	Source="{ThemeFileBinding Name, PathFormat='Images/Filter/{0}.png'}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2">
                                    <Image.Style>
                                        <Style>
                                            <Setter Property="Image.Visibility" Value="Visible"/>
                                        </Style>
                                    </Image.Style>
                                </Image>

							<Image x:Name="FilterIconInverted" RenderOptions.BitmapScalingMode="Fant"
						 	Source="{ThemeFileBinding Name, PathFormat='Images/FilterInverted/{0}.png'}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2" >
                                    <Image.Style>
                                        <Style>
                                            <Setter Property="Image.Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Image.Style>
                                </Image>
                              
                                <StackPanel>
                                    <TextBlock x:Name="Nom" Text="{Binding Name}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="30" Margin="0,7.5,0,0" FontSize="20">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Padding" Value="5,0,5,0"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                                                        <Setter Property="FontFamily" Value="{DynamicResource Comfortaa}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding ElementName=FilterIcon, Path=Source}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding ElementName=FilterIconInverted, Path=Source}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>

                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>                               
                            </Grid></Border> 
                        </TextBlock>
                    </Grid></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GlyphBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Foreground" Value="Black" TargetName="Nom" />
                            <Setter Property="Image.Visibility" Value="Visible" TargetName="FilterIconInverted" />
                            <Setter Property="Image.Visibility" Value="Collapsed" TargetName="FilterIcon" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GlyphBrush}" TargetName="SelectionBorder" />
                            <Setter Property="Foreground" Value="Black" TargetName="Nom" />
                            <Setter Property="Image.Visibility" Value="Visible" TargetName="FilterIconInverted" />
                            <Setter Property="Image.Visibility" Value="Collapsed" TargetName="FilterIcon" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type FilterPresetSelector}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPresetSelector}">
                    <ItemsControlEx x:Name="PART_ItemsFilterPresets" Focusable="False"
                                    KeyboardNavigation.DirectionalNavigation="Once"
                                    HorizontalLayout="True">
                        <ItemsControl.ItemsPanel>                            
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControlEx>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>