<UserControl x:Class="Playnite.DesktopApp.Controls.GameFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="40,30,40,30" MaxWidth="900" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource LOCGameFoldersTitle}"
                   FontSize="{DynamicResource FontSizeLargest}" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="{DynamicResource LOCGameFoldersDescription}"
                   Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,18" />

        <CheckBox Grid.Row="2" Content="{DynamicResource LOCGameFoldersAutoScanOnStartup}"
                  IsChecked="{Binding AppSettings.AutoScanGameFoldersOnStartup}"
                  Margin="0,0,0,18" VerticalContentAlignment="Center" />

        <Border Grid.Row="3" BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1"
                CornerRadius="3" Padding="2">
            <ListBox ItemsSource="{Binding AppSettings.GameScanFolders}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" Margin="4,3,4,3">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource LOCRemoveTitle}"
                                    Margin="10,0,0,0" Padding="10,3,10,3"
                                    Command="{Binding DataContext.RemoveGameFolderCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource BaseTextBlockStyle}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="3" Text="{DynamicResource LOCGameFoldersEmpty}"
                   Foreground="{DynamicResource TextBrushDarker}"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AppSettings.GameScanFolders.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,18">
            <Button Content="{DynamicResource LOCGameFoldersAddFolder}"
                    Command="{Binding AddGameFolderCommand}" Padding="14,6,14,6" Margin="0,0,10,0" />
            <Button Content="{DynamicResource LOCGameFoldersScanNow}"
                    Command="{Binding ScanGameFoldersCommand}" Padding="14,6,14,6" />
        </StackPanel>

        <StackPanel Grid.Row="5">
            <TextBlock Text="{DynamicResource LOCGameFoldersExcludeListTitle}"
                       FontSize="{DynamicResource FontSizeLarge}" Margin="0,0,0,4" />
            <TextBlock Text="{DynamicResource LOCGameFoldersExcludeListDescription}"
                       Style="{DynamicResource BaseTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,10" />
            <Border BorderBrush="{DynamicResource PanelSeparatorBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="2" MaxHeight="200">
                <ListBox ItemsSource="{Binding AppSettings.ExcludedGameExes}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Margin="4,3,4,3">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource LOCRemoveTitle}"
                                        Margin="10,0,0,0" Padding="10,3,10,3"
                                        Command="{Binding DataContext.RemoveExcludedExeCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource BaseTextBlockStyle}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <TextBlock Text="{DynamicResource LOCGameFoldersExcludeListEmpty}"
                       Foreground="{DynamicResource TextBrushDarker}" Margin="2,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AppSettings.ExcludedGameExes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
